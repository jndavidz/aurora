[Unit]
Description=Credential keeper probe (fetch aurora credential health, D4)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
SuccessExitStatus=1
EnvironmentFile=/etc/credential-keeper.env
ExecStart=/usr/bin/node /opt/credential-keeper/keeper.mjs
# 退出码:0=ok 1=有凭证告警 2=探测失败;oneshot 结果在 list-timers 可见

[Install]
WantedBy=multi-user.target
