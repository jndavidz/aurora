# 网页 token 注入池文件路径(每行一条,<x-uskey>\t<cookie header>;只放可丢弃小号)
# X-Uskey 与 cookie(hy_user/hy_token 等)都从已登录浏览器抓取,缺任一 401;
# 随登录稳定(重登后需重新提取,见 docs/YUANBAO.md §二)。
# 仅当配置了该文件时,Yuanbao provider 才会注册。
# YUANBAO_WEB_TOKENS=

# 网页端 base(默认 https://yuanbao.tencent.com)
# YUANBAO_WEB_BASE=

# 元宝主 agent id(页面 /chat/<agentId>;默认 naQivTmsDa,hy3/deepseek 共用)
# YUANBAO_AGENT_ID=

# 网页通道出口代理(可选)
# YUANBAO_PROXY=


