SERVER_HOST=0.0.0.0
SERVER_PORT=8080
PORT=8080

FREE_ACCOUNTS=true
FREE_ACCOUNTS_NUM=1024
Authorization=

TLS_CERT=
TLS_KEY=
PROXY_URL=
http_proxy=

# 转发代理（可选，给 backend-api / files 端点单独配置）
API_REVERSE_PROXY=
FILES_REVERSE_PROXY=

# 自定义 BASE_URL（默认 https://chatgpt.com/backend-api）
BASE_URL=

# 流式响应开关；设为 "false" 强制返回完整响应
STREAM_MODE=true

# 是否在请求中保留历史上下文；设为 "true" 启用
ENABLE_HISTORY=false

# MAX_CONTINUE_COUNT: 模型因 max_tokens 停止时,自动 continue 的最大轮数。
# 默认 3;设为 0 可关闭自动 continue(遇到长度限制立即停止,不再续写)。
MAX_CONTINUE_COUNT=3

# DEBUG_SSE: 设为 "true" 时,在控制台打印每个 SSE chunk 的解析日志,
# 用于排查流式响应丢包/截断问题。生产建议留空。
# DEBUG_SSE=true

# ---------- 工具调用模拟（Tool Calling Emulation）----------
# ChatGPT Web 不原生支持 function calling。aurora 复刻  的
# <tool_call>{...}</tool_call> 文本协议:在 system prompt 中教模型按格式输出,
# 流式响应中实时切分出 tool_calls。
#
# TOOL_CALLING_ENABLED: 是否启用。默认 true(只要请求体里声明了 tools)。
#   设为 false / 0 / no 强制关闭(忽略 tools 字段)。
# 启用时强制 stream=false(sandbox 重试需要完整响应),返回非流式 ChatCompletion。
TOOL_CALLING_ENABLED=true

# REFUSAL_RETRIES: 模型陷入"sandbox 拒绝"循环时的最大重试次数。
# 每次重试会在末尾追加 _retrySuffix 提示模型立即输出 <tool_call> 块。
# 仅在工具调用模式生效;默认 3。
REFUSAL_RETRIES=3

# ---------- provider 工具调用(方案 A 模拟 / 方案 B 透传)----------
# ChatGPT 之外,网页逆向 provider 的 chat 变体不认 tools。带 tools 时的优先级:
# 方案 B(原生透传)> 方案 A(网关模拟)> 现状(provider 剥离 tools)。默认全关/全空。
#
# PROVIDER_TOOL_EMULATION: 方案 A 总开关。true 时在网关侧注入
#   <tool_calling_protocol>,收集全文后解析成标准 tool_calls;解析不到则降级为
#   普通文本。默认 false(不开即不改变任何已有行为)。以下情况不注入、直接走
#   provider 原路径:tool_choice="none"(客户端显式禁止工具)、-coding 变体。
PROVIDER_TOOL_EMULATION=false

# PROVIDER_TOOL_MODELS: 方案 A 的模型白名单(逗号分隔,默认空 = 不限模型)。
#   按 ResolveCanonical 回填后的 id 匹配(大小写/空白容错之后);建议先单模型灰度。
# PROVIDER_TOOL_MODELS=deepseek-no-search

# PROVIDER_TOOL_RETRIES: 模型未按协议输出 <tool_call> 时的额外重试次数(默认 3,
#   总尝试 = 1 + N);0 合法 = 只跑一次。重试之间按 400ms×N 退避(上限 2s)。
#   重试是 N 次独立收集(新会话/重传图),仅在失败路径发生。
PROVIDER_TOOL_RETRIES=3

# NATIVE_TOOLS_BASE / NATIVE_TOOLS_KEY: 方案 B 的上游(OpenAI 兼容)base 与 key,
#   两者都非空才启用;请求原样透传给 <BASE>/chat/completions,由上游真正执行工具。
#   留空 = 不启用 B(工具请求继续走 A / 现有路径)。
# NATIVE_TOOLS_BASE=https://api.deepseek.com/v1
# NATIVE_TOOLS_KEY=sk-...

# NATIVE_TOOLS_MODEL_MAP: 客户端 model id → 上游 model id,逗号分隔,形如
#   "<客户端 id>=<上游 id>"。空、缺 '='、任一侧为空或左值重复 = 整个 provider
#   不注册(fail-closed,启动日志会说明原因)。注意:映射里的模型只接管带 tools
#   的 /v1/chat/completions(不带 tools 的对话 → 400 missing_tools),/v1/models
#   不会列出这些 id;熔断期间槽位自动跳过,请求回落到方案 A / 已注册 provider。
# NATIVE_TOOLS_MODEL_MAP=deepseek-no-search=deepseek-chat

# DEBUG_TOOL_LOG: 设为文件路径后,把每次工具解析的详细 trace 写入该文件
# (输入 text、解析结果、tool_calls 等)。调试用,生产建议留空。
# DEBUG_TOOL_LOG=tool_debug.log

# ---------- DeepSeek 网页逆向(chat.deepseek.com)通道 ----------
# 对外模型目录通过 DEEPSEEK_MODELS 暴露:
#   deepseek : 纯真人对话(快速模式 + 智能搜索 + 非深度思考;搜索恒开,
#              不受 DEEPSEEK_WEB_SEARCH 影响;识图与搜索互斥)
#   -coding  : 文本协议工具调用(已封存,见 docs/CHATGPT_TOOL_BRIDGE.md)
# 默认(不配置时): deepseek
# DEEPSEEK_MODELS=

# 网页 token 注入池文件路径(每行一个 user_token;只放可丢弃小号,主号永不入池)
# 仅当配置了该文件时,DeepSeek provider 才会注册。
# DEEPSEEK_WEB_TOKENS=

# 网页端 base(默认 https://chat.deepseek.com)
# DEEPSEEK_WEB_BASE=

# 网页通道出口代理(非美区,绕 WAF;参考 deepseek网页协议整理.md §2.3)
# DEEPSEEK_PROXY=

# quick 档是否带联网搜索(仅对非 SearchAlways 模型生效;exposed id "deepseek"
# 定义即「智能搜索+非深度思考」,恒开搜索,不受此开关影响)。
# DEEPSEEK_WEB_SEARCH=1

# expert(深度思考)档是否参与上游会话复用。默认 1(live 验证 2026-09-27:
# expert 续轮正常,thinking 语义与服务端记忆均生效)。仅在上游变更导致 expert
# 续轮异常时置 0,让 expert 退回每轮新开(quick 档不受影响)。
# DEEPSEEK_EXPERT_RESUME=1

# ---------- 智谱清言(chatglm.cn)网页逆向通道 ----------
# 对外模型目录通过 GLM_MODELS 暴露;只接受 glm-5.2- 前缀(glm-5 系列已下线):
#   -chat            : 快速挡(chat_mode=speed),纯真人对话,联网搜索 + 识图
#   -chat-thinking   : 思考挡(chat_mode=thinking),纯真人对话,深度思考 + 联网搜索 + 识图
#   -coding          : 云端沙箱代码执行助手(智谱无 function calling,见 docs/GLM.md §四;
#                      客户端自定义工具调用是尽力而为,不保证)
# 默认(不配置时): glm-5.2-chat, glm-5.2-chat-thinking, glm-5.2-coding
# GLM_MODELS=

# 网页 token 注入池文件路径(每行一个 chatglm_refresh_token;只放可丢弃小号)
# 仅当配置了该文件时,Glm provider 才会注册。
# 注意:refresh_token 是长期凭据,换发 access_token(JWT,~2h)后每次请求用 JWT。
# GLM_WEB_TOKENS=

# 网页端 base(默认 https://chatglm.cn)
# GLM_WEB_BASE=

# 网页通道出口代理(可选)
# GLM_PROXY=

# chat 档(glm-5.2-chat/chat-thinking)是否带联网搜索。默认关闭(提速);
# 需要网页代查才设 1。
# GLM_WEB_SEARCH=1

# ---------- 千问(www.qianwen.com)网页逆向通道 ----------
# 对外模型目录通过 QIANWEN_MODELS 暴露;千问网页 API 不支持自定义外部工具
# (tools 字段被忽略,见 docs/QIANWEN.md §〇),只有纯对话 chat 形态。
# 默认(不配置时): qwen(上游指向 Qwen3.6-Flash;经 upstreamSlug 映射)
# QIANWEN_MODELS=

# 网页 token 注入池文件路径(每行一个完整 cookie header;只放可丢弃小号)
# 格式: tongyi_sso_ticket=<ticket>[; x5sec=<x5sec>; x5sectag=<tag>; sm_ruid=<ruid>; sm_uuid=<uuid>]
# tongyi_sso_ticket 是浏览器 httpOnly cookie(约 1 年有效期)做账号凭据;WAF 升级后还需
# x5sec 通关 cookie(约 20 分钟,浏览器过滑块签发,见 docs/QIANWEN.md §一)。
# 仅当配置了该文件时,Qianwen provider 才会注册。
# QIANWEN_WEB_TOKENS=

# 网页端 base(默认 https://chat2.qianwen.com)
# QIANWEN_WEB_BASE=

# 网页通道出口代理(可选)
# QIANWEN_PROXY=

# ---------- Grok(grok.com)网页逆向通道 ----------
# 对外模型目录通过 GROK_MODELS 暴露;每个 id 用 -chat / -coding 后缀路由:
#   -chat  : 纯真人对话(模型自动用原生搜索 + 云端沙盒)
#   -coding: 云端沙盒代码执行助手(同智谱 glm-*-coding 定位,见 docs/GROK.md)
# 默认(不配置时): grok-3-chat, grok-3-coding
# GROK_MODELS=

# 网页 cookie 池文件路径(每行 uid|cookie 串)。cookie 从浏览器登录 grok.com 后
# 提取:uid = x-userid cookie 值;cookie = 完整 cookie 串(含 sso/sso-rw 等,
# 与 WebSocket 握手一起发送)。仅当配置了该文件时 Grok provider 注册。
# GROK_COOKIES=

# ---------- Gemini(gemini.google.com)网页逆向通道 ----------
# 对外模型目录通过 GEMINI_MODELS 暴露;每个 id 用 -chat / -coding 后缀路由:
#   -chat  : 纯真人对话(模型自动用原生搜索/地图)
#   -coding: 客户端工具调用可靠(实测优于智谱/Grok,见 docs/GEMINI.md §四)
# 默认(不配置时): gemini-3-flash-chat, gemini-3-flash-coding
# GEMINI_MODELS=

# 网页账号池 JSON 文件路径(每对象含 cookie/at/snlM6e/fsid,见 docs/GEMINI.md §六)。
# 仅当配置了该文件时 Gemini provider 注册。
# ⚠️ 直连已停用(数据中心 IP + 模拟指纹被 Google 风控);改用 CDP 桥通道。
# GEMINI_ACCOUNTS=

# ---------- Gemini CDP 桥通道(真浏览器执行,推荐) ----------
# 由家庭 PC 上的 scripts/cdp/bridge.mjs 用真实浏览器页内 fetch 执行 gemini.google.com
# 对话(零指纹模拟),aurora 只做 HTTP 转发(见 docs/GEMINI.md §八)。
# 仅当 GEMINI_CDP_URL 配置时注册(与 GEMINI_ACCOUNTS 直连互斥,直连已停用)。
# GEMINI_CDP_URL=http://<PC_IP>:8799
# GEMINI_CDP_KEY=        # 可选:与桥的 BRIDGE_AUTH 一致

# ---------- Claude CDP 桥通道(真浏览器执行) ----------
# 与 Gemini 共用同一 CDP 桥服务(scripts/cdp/bridge.mjs 的 claude 适配器),
# 桥地址默认复用 GEMINI_CDP_URL;仅当 CLAUDE_CDP_URL 配置时注册。
# 模型: claude-sonnet-5-chat / claude-sonnet-5-coding(见 docs/CLAUDE.md)。
# CLAUDE_CDP_URL=http://<PC_IP>:8799
# CLAUDE_CDP_KEY=
# CLAUDE_MODELS=

# ---------- 豆包(doubao.com)CDP 桥通道(真浏览器执行,2026-09-04) ----------
# 网页版 cookie 直连已被风控封死(回声/空响应/滑块,实测)。走 NUC Chrome 页内
# fetch(字节 JS hook 自动注入 a_bogus/msToken,实时签名永不过期);会话状态由
# 桥 capture 钩子从页面真实请求持续同步。桥地址默认复用 GEMINI_CDP_URL。
# 需 NUC Chrome 保持豆包页面登录;用户 VNC 聊天推进会话时桥状态自动跟进。
# 模型: doubao-chat。
# DOUBAO_CDP_URL=http://<NUC_IP>:8799
# DOUBAO_CDP_KEY=
# DOUBAO_CDP_MODELS=

